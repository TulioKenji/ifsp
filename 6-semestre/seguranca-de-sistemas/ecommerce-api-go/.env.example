# Desenvolvimento local. Em Ubuntu use os papéis separados de deploy/ubuntu.md.
DATABASE_URL=host=127.0.0.1 port=5432 dbname=greenstore user=postgres password=troque-esta-senha connect_timeout=5 sslmode=disable
# Opcionais, lidos somente por dbsetup (nunca pelo servidor HTTP):
# DATABASE_SETUP_URL=host=127.0.0.1 port=5432 dbname=greenstore user=greenstore_owner password=troque sslmode=disable
# DATABASE_ADMIN_URL=host=127.0.0.1 port=5432 dbname=postgres user=postgres password=troque sslmode=disable
PRODUCTION=0
# Gere uma vez: go run ./cmd/keygen. Não troque uma chave com dados já gravados.
DATA_KEY_FILE=.secrets/data.key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500
SPA_DIR=../ecommerce-front-spa/dist
HTTP_ADDR=:8080
DB_MAX_CONNECTIONS=4
HTTP_MAX_INFLIGHT=16
HTTP_MAX_CONNECTIONS=128
HTTP_CONNECTIONS_PER_IP=32
HTTP_RATE_PER_MINUTE=180
# HTTPS direto no Go dispensa proxy. Os dois arquivos precisam estar configurados juntos.
# TLS_CERT_FILE=/etc/greenstore/tls/fullchain.pem
# TLS_KEY_FILE=/etc/greenstore/tls/privkey.pem
